ENV=development
LOG_LEVEL=DEBUG

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=medapp
POSTGRES_PASSWORD=medapp
POSTGRES_DB=medapp

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://medapp:medapp@rabbitmq:5672/

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

GCS_BUCKET=medapp-dev-uploads
GCP_PROJECT_ID=medapp-dev

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Used by every service under agents/. The SDK picks this up automatically.
ANTHROPIC_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SENTRY_DSN=
