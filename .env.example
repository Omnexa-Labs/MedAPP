ENV=development
LOG_LEVEL=DEBUG

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=medapp
POSTGRES_PASSWORD=medapp
POSTGRES_DB=medapp

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://medapp:medapp@rabbitmq:5672/

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# user_service email OTP and password recovery (USER_ prefix is required).
# Configure these in user_service's environment / Compose environment mapping.
# Without host and sender, email-dependent endpoints return 503.
USER_SMTP_HOST=
USER_SMTP_PORT=587
USER_SMTP_FROM_EMAIL=
USER_SMTP_USERNAME=
USER_SMTP_PASSWORD=
USER_SMTP_SECURITY=starttls
USER_SMTP_TIMEOUT_SECONDS=10
USER_PASSWORD_RESET_TTL_MINUTES=30
USER_PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=30

# Independent Fernet key for server-side authenticator secrets. Keep in secret storage.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty disables new authenticator setup; it never disables enrolled-account challenges.
USER_MFA_ENCRYPTION_KEY=

# Provider sign-in: environment-specific OAuth audiences; blank keeps providers off.
# Google: Web, iOS and Android OAuth client IDs, comma-separated. Apple: native bundle ID.
# See docs/PROVIDER_SIGN_IN_SETUP.md. No provider client secret is used in this native flow.
USER_GOOGLE_CLIENT_IDS=
USER_APPLE_CLIENT_IDS=
USER_ADMIN_GOOGLE_CLIENT_ID=
USER_ADMIN_WORKSPACE_DOMAINS=

# Mobile-to-partner handoff: a separate, matching secret on user_service and partner_web.
# Generate at least 32 random bytes and keep the value only in the server secret store.
USER_PARTNER_HANDOFF_SECRET=
USER_PARTNER_WEB_ORIGIN=
USER_PARTNER_RETURN_URIS=medapp://onboarding-status
USER_HMS_HANDOFF_SECRET=
USER_HMS_WEB_ORIGIN=
USER_HMS_RETURN_URIS=medapp://hospital-workspaces
# Per-deployment pharmacy handoff map; see docs/api/pharmacy_service.md.
# Each key/origin matches PHARMACY_PMS_DEPLOYMENTS. Credentials stay server-side.
USER_PMS_HANDOFF_DEPLOYMENTS={}
USER_PMS_RETURN_URIS=medapp://pharmacy-workspaces
USER_PHARMACY_SERVICE_URL=http://pharmacy_service:8015

# Internal identity lookup used when patients grant EHR access to a doctor/nurse.
EHR_USER_SERVICE_URL=http://user_service:8001

GCS_BUCKET=medapp-dev-uploads
GCP_PROJECT_ID=medapp-dev

# Private professional application credentials. Blank disables uploads/downloads.
# Use a private bucket and Application Default Credentials in the service runtime.
# The general GCS_BUCKET value is not used for onboarding credentials.
ONBOARDING_GCS_BUCKET=
ONBOARDING_DOCUMENT_MAX_BYTES=10485760
ONBOARDING_DOCUMENT_LIMIT=20

# Approved clinician and hospital activation. Configure different server-only secrets
# (at least 32 random bytes each), apply receiver and onboarding migrations, then enable.
# Compose passes each receiver secret to its corresponding onboarding worker client.
ONBOARDING_ACTIVATION_ENABLED=false
USER_ONBOARDING_ACTIVATION_SECRET=
DOCTOR_ONBOARDING_ACTIVATION_SECRET=
NURSE_ONBOARDING_ACTIVATION_SECRET=
HOSPITAL_ONBOARDING_ACTIVATION_SECRET=
HMS_ONBOARDING_ACTIVATION_SECRET=
PHARMACY_ONBOARDING_ACTIVATION_SECRET=

# Each PMS deployment has its own database, session key, activation key and stock key.
# Server-only JSON map; see docs/api/pharmacy_service.md for its shape and assignment steps.
PHARMACY_PMS_DEPLOYMENTS={}
# Public gateway origin used for published pharmacy photos; use HTTPS in production.
PHARMACY_PUBLIC_API_ORIGIN=http://localhost:8000
PMS_MEDAPP_DEPLOYMENT_KEY=
PMS_ONBOARDING_ACTIVATION_SECRET=
PMS_JWT_SECRET=
PMS_MEDAPP_WEBHOOK_SECRET=
# Run the pms_medapp_sync worker after applying PMS and pharmacy migrations.
PMS_MEDAPP_SYNC_URL=http://pharmacy_service:8015/v1/pharmacy-sync/events
# Exact browser origin for this PMS portal; use HTTPS in production.
PMS_WEB_ORIGIN=http://127.0.0.1:3002
# Match this deployment's handoff_secret in USER_PMS_HANDOFF_DEPLOYMENTS.
PMS_WEB_HANDOFF_SECRET=
PMS_WEB_RETURN_URIS=medapp://pharmacy-workspaces

# Separate HMS session signing key, shared only by HMS and the gateway.
# Hospital activation requires this key and HMS_DEV_MODE=false.
HMS_WORKSPACE_SESSION_SECRET=

# Dedicated HMS-to-directory credential (at least 32 characters, distinct from
# platform/workspace signing keys and onboarding activation credentials).
# Compose sends this as HOSPITAL_HMS_DIRECTORY_SECRET to the directory receiver.
HMS_HOSPITAL_DIRECTORY_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Used by every service under agents/. The SDK picks this up automatically.
ANTHROPIC_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SENTRY_DSN=
## Internal EHR -> pharmacy prescription delivery; use a distinct random secret (at least 32 characters).
CLINICAL_HANDOFF_SECRET=

# Medication push: enable only after Expo project credentials and a native build are configured.
EHR_MEDICATION_PUSH_ENABLED=false
EHR_EXPO_ACCESS_TOKEN=
