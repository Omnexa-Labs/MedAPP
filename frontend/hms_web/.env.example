# Server-only settings. Use HTTPS origins and private Redis in production.
HMS_WEB_ORIGIN=http://127.0.0.1:3001
HMS_WEB_API_URL=http://127.0.0.1:8000
HMS_WEB_REDIS_URL=redis://127.0.0.1:6379
HMS_WEB_HANDOFF_SECRET=
HMS_WEB_RETURN_URIS=medapp://hospital-workspaces
# Configure the backend's HMS_WORKSPACE_SESSION_SECRET separately.
# No MedApp or HMS bearer tokens/signing keys belong in NEXT_PUBLIC variables.
