{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "dev",
        "USE_MOCK_API": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "preview",
        "USE_MOCK_API": "false",
        "API_BASE_URL": "https://preview-api.medapp.dev"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "prod",
        "USE_MOCK_API": "false",
        "API_BASE_URL": "https://api.medapp.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
