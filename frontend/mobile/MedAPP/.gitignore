# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
#
# `android/` and `ios/` are BUILD OUTPUT here, not source. This is a managed
# (CNG) Expo project: `npx expo prebuild` — which `expo run:android` invokes —
# regenerates both deterministically from app.json plus the config plugins, so
# committing them would create a second source of truth that silently drifts
# from the config and then has to be reconciled by hand.
#
# They exist locally only so a development build can be installed on a physical
# device (needed because Expo Go is pinned to one SDK and the Play Store only
# ships the newest, which will not run this project's SDK 55).
#
# If the project ever genuinely needs hand-edited native code, that is the point
# to un-ignore these and adopt the bare workflow deliberately — not by letting a
# build tool decide it.
/android
/ios
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# Local Firebase client configuration and private signing/provider files.
# Cloud builds receive the client config through an EAS file environment variable.
/credentials/
google-services*.json
*service-account*.json
*firebase-adminsdk*.json
credentials.json

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
