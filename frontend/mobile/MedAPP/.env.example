# Local device must be able to reach the gateway; use your own host address.
APP_ENV=dev
API_BASE_URL=http://10.0.2.2:8000
PARTNER_ONBOARDING_URL=http://10.0.2.2:3003
HMS_WEB_URL=http://10.0.2.2:3001

# Public OAuth identifiers only. Leave blank until the matching provider apps exist.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_SIGN_IN_ENABLED=false

# Public Expo project identifier and local Firebase config path for native push builds.
# See ../../../docs/MOBILE_BUILD_SETUP.md. Each EAS profile needs its own cloud environment.
# Physical Android phones need a reachable API_BASE_URL, not the emulator default above.
EAS_PROJECT_ID=
ANDROID_GOOGLE_SERVICES_FILE=
