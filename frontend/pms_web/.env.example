# Server-only settings. One portal serves one PMS deployment.
PMS_WEB_ORIGIN=http://127.0.0.1:3002
PMS_WEB_API_URL=http://127.0.0.1:8030
PMS_WEB_MEDAPP_API_URL=http://127.0.0.1:8000
PMS_WEB_REDIS_URL=redis://127.0.0.1:6379
# Must match PMS_MEDAPP_DEPLOYMENT_KEY and the assigned directory deployment.
PMS_WEB_DEPLOYMENT_KEY=
# Match the same deployment entry in USER_PMS_HANDOFF_DEPLOYMENTS.
# Use a separate 32+ character server credential, never a signing/activation key.
PMS_WEB_HANDOFF_SECRET=
PMS_WEB_RETURN_URIS=medapp://pharmacy-workspaces
# Use an HTTPS origin for production and keep Redis on the private network.
# No MedApp or PMS tokens/signing keys belong in NEXT_PUBLIC variables.
