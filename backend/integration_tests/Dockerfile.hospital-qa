# Disposable backend QA runner. Build with backend/ as its context.
FROM python:3.12-slim
WORKDIR /workspace/backend
COPY shared/pyproject.toml /requirements/shared.toml
COPY services/user_service/pyproject.toml /requirements/user.toml
COPY services/hospital_service/pyproject.toml /requirements/hospital.toml
COPY services/hms_service/pyproject.toml /requirements/hms.toml
COPY services/onboarding_service/pyproject.toml /requirements/onboarding.toml
COPY services/api_gateway/pyproject.toml /requirements/gateway.toml
COPY services/pharmacy_service/pyproject.toml /requirements/pharmacy.toml
COPY services/pms_service/pyproject.toml /requirements/pms.toml
RUN python -c "import pathlib,tomllib; deps={d for p in pathlib.Path('/requirements').glob('*.toml') for d in tomllib.loads(p.read_text())['project']['dependencies'] if d != 'medapp-shared'}; pathlib.Path('/requirements/tests.txt').write_text('\n'.join(sorted(deps | {'pytest>=8.3','pytest-asyncio>=0.23','aiosqlite>=0.20'})))"
RUN pip install --no-cache-dir -r /requirements/tests.txt
COPY shared/shared ./shared/shared
COPY services/user_service ./services/user_service
COPY services/hospital_service ./services/hospital_service
COPY services/hms_service ./services/hms_service
COPY services/onboarding_service ./services/onboarding_service
COPY services/api_gateway ./services/api_gateway
COPY services/pharmacy_service ./services/pharmacy_service
COPY services/pms_service ./services/pms_service
COPY integration_tests ./integration_tests
ENV PYTHONPATH=/workspace/backend/shared PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "-m", "pytest", "integration_tests/test_hospital_activation.py", "integration_tests/test_hospital_directory_migration.py", "-q", "--tb=short", "--junitxml=/results/hospital-http-postgres.xml"]
