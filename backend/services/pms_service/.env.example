# Pharmacy Management System — local dev env vars
# Copy to .env and edit. All variables are prefixed PMS_.

PMS_DEV_MODE=true
PMS_DEV_DATABASE_URL=postgresql+asyncpg://medapp:medapp@localhost:5432/pms_dev

# Production-ish defaults (used when PMS_DEV_MODE=false)
PMS_DATABASE_URL=postgresql+asyncpg://medapp:medapp@postgres:5432/medapp_pms
PMS_DATABASE_URL_SYNC=postgresql+psycopg://medapp:medapp@postgres:5432/medapp_pms

PMS_JWT_SECRET=change-me-change-me-change-me-change-me
PMS_LOG_LEVEL=INFO

# Pharmacy identity (set once per deployment)
PMS_PHARMACY_NAME=Demo Pharmacy
PMS_PHARMACY_SLUG=demo
PMS_PHARMACY_CURRENCY=GHS
PMS_PHARMACY_COUNTRY=GH

# MedApp integration — leave empty to disable outbound calls
PMS_MEDAPP_WEBHOOK_SECRET=replace-with-shared-secret-from-medapp
# Exact MedApp receiver; requires a confirmed workspace and the separate worker.
PMS_MEDAPP_SYNC_URL=
PMS_MEDAPP_DEPLOYMENT_KEY=
PMS_MEDAPP_PARTNER_ID=

PMS_CORS_ALLOW_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
